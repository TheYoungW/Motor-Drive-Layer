<?xml version="1.0" encoding="UTF-8"?>
<!-- Documentation template. The service builds the equivalent URI from
     runtime-service.conf so interface names have one source of truth. -->
<CycloneDDS>
  <Domain Id="0">
    <General>
      <Interfaces>
        <NetworkInterface name="eth0" priority="20" presence_required="false"/>
        <NetworkInterface name="eth1" priority="10" presence_required="false"/>
        <NetworkInterface name="wlan0" priority="0" presence_required="false"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
