[Unit]
Description=Articore RK3588 Runtime Service
After=network-online.target articore-can.service
Wants=network-online.target
Requires=articore-can.service

[Service]
Type=simple
User=articore-runtime
Group=articore-runtime
ExecStartPre=/usr/libexec/articore/articore-wait-dds-network /etc/articore/runtime-service.conf
ExecStart=/usr/bin/articore-runtime-service /etc/articore/runtime-service.conf
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=1
# Keep the service loop, Cyclone DDS workers, maintenance workers and any
# diagnostics on the housekeeping cores.  The dedicated Runtime/CAN workers
# explicitly override this inherited mask with CPU 7/6/5 below.
CPUAffinity=0 1 2 3 4
CPUSchedulingPolicy=other
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=90
LimitMEMLOCK=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN
Environment=LD_LIBRARY_PATH=/usr/lib/articore
Environment=ARTICORE_RUNTIME_CONTROL_HZ=500

[Install]
WantedBy=multi-user.target
