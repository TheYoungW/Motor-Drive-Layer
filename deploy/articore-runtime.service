[Unit]
Description=Articore RK3588 Runtime Service
After=network-online.target articore-can.service
Wants=network-online.target
Requires=articore-can.service

[Service]
Type=simple
User=articore-runtime
Group=articore-runtime
ExecStart=/usr/bin/articore-runtime-service /etc/articore/runtime-service.conf
Restart=on-failure
RestartSec=1
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=90
LimitMEMLOCK=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN
Environment=LD_LIBRARY_PATH=/usr/lib/articore

[Install]
WantedBy=multi-user.target
